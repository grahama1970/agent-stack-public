{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.dev/battle/action-catalog.v2",
  "title": "Battle action catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalog_id",
    "version",
    "root_id",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "battle.action_catalog.v2"
    },
    "catalog_id": {
      "const": "battle-canonical"
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "root_id": {
      "type": "string",
      "pattern": "^battle\\.[a-z0-9_.-]+$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "family_path",
        "name",
        "description",
        "kind",
        "team",
        "eligibility",
        "timing",
        "cost",
        "risk",
        "runtime",
        "arguments",
        "evidence",
        "judge",
        "outcome_codes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^battle\\.[a-z0-9_.-]+$"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "family_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 80
        },
        "kind": {
          "enum": [
            "root",
            "category",
            "action"
          ]
        },
        "team": {
          "enum": [
            "shared",
            "red",
            "blue"
          ]
        },
        "eligibility": {
          "$ref": "#/$defs/eligibility"
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "arguments": {
          "$ref": "#/$defs/arguments"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "judge": {
          "$ref": "#/$defs/judge"
        },
        "outcome_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^BATTLE_[A-Z0-9_]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            }
          },
          "then": {
            "required": [
              "arguments"
            ],
            "properties": {
              "arguments": {
                "required": [
                  "type",
                  "properties",
                  "required",
                  "additionalProperties"
                ],
                "properties": {
                  "additionalProperties": {
                    "const": false
                  },
                  "maxProperties": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "required": {
                    "minItems": 1
                  },
                  "properties": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 16,
                    "additionalProperties": false,
                    "patternProperties": {
                      "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                        "$ref": "#/$defs/argument_property"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "root",
                  "category"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "target_state",
        "dependencies"
      ],
      "properties": {
        "authorization": {
          "const": "security.target_authorization.v1"
        },
        "target_state": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "authorized"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^battle\\.[a-z0-9_.-]+$"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_ms",
        "cooldown_ms"
      ],
      "properties": {
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "cooldown_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_units",
        "capacity_units"
      ],
      "properties": {
        "budget_units": {
          "type": "number",
          "minimum": 0
        },
        "capacity_units": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "requires_isolation"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "requires_isolation": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "profiles"
      ],
      "properties": {
        "executor": {
          "const": "tau"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "docker",
              "qemu"
            ]
          }
        }
      }
    },
    "arguments": {
      "anyOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "properties",
            "required",
            "additionalProperties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "additionalProperties": false,
              "patternProperties": {
                "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                  "$ref": "#/$defs/argument_property"
                }
              }
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "additionalProperties": {
              "const": false
            },
            "maxProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "types"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "stdout",
              "stderr",
              "runtime_receipt"
            ]
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_required",
        "authority"
      ],
      "properties": {
        "replay_required": {
          "type": "boolean"
        },
        "authority": {
          "const": "judge"
        }
      }
    },
    "argument_property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ]
        },
        "items": {
          "$ref": "#/$defs/argument_property"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
