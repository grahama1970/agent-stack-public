{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/battle/schemas/battle.exact_judge_pair_replay.v2.schema.json",
  "title": "Battle exact Judge pair replay receipt v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "status",
    "matched",
    "receipt_valid",
    "docker_image",
    "docker_image_id",
    "target_identity_sha256",
    "original_fingerprint",
    "replay_fingerprint",
    "immutable_pair",
    "judge_input_byte_bindings",
    "environment_identity"
  ],
  "properties": {
    "schema": {
      "const": "battle.exact_judge_pair_replay.v2"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "matched": {
      "type": "boolean"
    },
    "receipt_valid": {
      "type": "boolean"
    },
    "docker_image": {
      "type": "string"
    },
    "docker_image_id": {
      "type": "string",
      "pattern": "^sha256:.+"
    },
    "replay_docker_image_id": {
      "type": "string",
      "pattern": "^sha256:.+"
    },
    "target_identity_sha256": {
      "type": "string"
    },
    "compile_receipts": {
      "type": "array"
    },
    "compile_receipts_complete": {
      "type": "boolean"
    },
    "judge_input_byte_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "original_fingerprint": {
      "type": "object"
    },
    "replay_fingerprint": {
      "type": "object"
    },
    "immutable_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "team",
          "path",
          "sha256"
        ],
        "additionalProperties": true
      }
    },
    "environment_identity": {
      "type": "object",
      "required": [
        "docker_image",
        "docker_image_id",
        "replay_docker_image_id"
      ],
      "properties": {
        "docker_image": {
          "type": "string"
        },
        "docker_image_id": {
          "type": "string",
          "pattern": "^sha256:.+"
        },
        "replay_docker_image_id": {
          "type": "string",
          "pattern": "^sha256:.+"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "compile_receipts"
        ],
        "properties": {
          "compile_receipts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/passCompileReceipt"
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "team": {
                      "const": "red"
                    }
                  },
                  "required": [
                    "team"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "team": {
                      "const": "blue"
                    }
                  },
                  "required": [
                    "team"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "passCompileReceipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "team",
        "schema",
        "status",
        "compile_status",
        "path",
        "sha256",
        "source_artifact_sha256",
        "compile_input_sha256",
        "selected_artifact_sha256",
        "docker_specimen_sha256",
        "docker_image",
        "docker_image_id",
        "compile_passed",
        "hash_matched"
      ],
      "properties": {
        "team": {
          "enum": [
            "red",
            "blue"
          ]
        },
        "schema": {
          "const": "battle.team_compile_receipt.v2"
        },
        "status": {
          "const": "PASS"
        },
        "compile_status": {
          "enum": [
            "PASS",
            "PASSED"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "compile_input_sha256": {
          "$ref": "#/$defs/hash"
        },
        "selected_artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "docker_specimen_sha256": {
          "$ref": "#/$defs/hash"
        },
        "docker_image": {
          "type": "string",
          "minLength": 1
        },
        "docker_image_id": {
          "type": "string",
          "pattern": "^sha256:.+"
        },
        "compile_passed": {
          "const": true
        },
        "hash_matched": {
          "const": true
        }
      }
    }
  }
}
